# Copy to .env and adjust. Never commit real credentials.
NODE_ENV=development
PORT=4000
# embedded dev database (pnpm db:start) listens on 5433; docker-compose uses 5432
DATABASE_URL=postgresql://irm:irm_dev_password@127.0.0.1:5433/irm
TEST_DATABASE_URL=postgresql://irm:irm_dev_password@127.0.0.1:5433/irm_test
# 32+ random bytes. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
WEB_ORIGIN=http://localhost:3100
COOKIE_SECURE=false
# Seed password for development users only
SEED_DEFAULT_PASSWORD=Agm!Dev2026

# Phase B
# Private file storage (local-disk driver). Relative to apps/api.
STORAGE_DIR=../../.data/storage
# dev-outbox stores sign-in codes in the database for development. Refused in production.
OTP_DELIVERY=dev-outbox
OTP_TTL_MINUTES=5
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MFA_ENCRYPTION_KEY=change-me-32-bytes-base64
MFA_ENFORCE_FOR_ADMINS=false

# Password sign-ins per minute per IP. Keep 10 outside local development.
LOGIN_RATE_LIMIT_PER_MINUTE=10
