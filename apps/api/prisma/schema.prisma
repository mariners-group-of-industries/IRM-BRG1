// IRM Platform — PostgreSQL schema.
//
// Phase A (foundation) entities only. Later phases add shareholder, meeting,
// voting and communication models in additive migrations. The full target ERD
// is documented in docs/DATABASE.md.
//
// Conventions
// - UUID primary keys generated by the database.
// - snake_case table and column names via @@map / @map.
// - Every company-owned row carries tenant_id and company_id for isolation.
// - Timestamps are timestamptz.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Platform & tenancy ────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// An organizational tenant: usually one corporate group.
model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String       @db.VarChar(160)
  slug      String       @unique @db.VarChar(60)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  companies   Company[]
  assignments UserRoleAssignment[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

enum CompanyType {
  PUBLIC_LISTED
  PUBLIC_UNLISTED
  PRIVATE
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

/// A legal entity that holds AGMs/EGMs. Belongs to exactly one tenant.
model Company {
  id                 String        @id @default(uuid(7)) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  legalName          String        @map("legal_name") @db.VarChar(200)
  shortName          String        @map("short_name") @db.VarChar(60)
  slug               String        @db.VarChar(60)
  companyType        CompanyType   @map("company_type")
  registrationNumber String?       @map("registration_number") @db.VarChar(60)
  tradingCode        String?       @map("trading_code") @db.VarChar(20)
  registeredAddress  String?       @map("registered_address") @db.VarChar(500)
  contactEmail       String?       @map("contact_email") @db.VarChar(254)
  timezone           String        @default("Asia/Dhaka") @db.VarChar(64)
  status             CompanyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments UserRoleAssignment[]
  auditLogs   AuditLog[]

  @@unique([tenantId, slug])
  /// Composite key target so child rows can enforce (tenant_id, company_id) consistency.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("companies")
}

// ─── Identity & access ─────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

/// A login identity. Users are global; what they can see is defined only by role assignments.
model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  email            String     @unique @db.VarChar(254)
  fullName         String     @map("full_name") @db.VarChar(160)
  /// argon2id hash. Null for participant identities that log in by OTP only.
  passwordHash     String?    @map("password_hash")
  status           UserStatus @default(ACTIVE)
  failedLoginCount Int        @default(0) @map("failed_login_count")
  lockedUntil      DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(3)
  mfaEnabled       Boolean    @default(false) @map("mfa_enabled")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments        UserRoleAssignment[] @relation("AssignedUser")
  grantedAssignments UserRoleAssignment[] @relation("GrantedBy")
  revokedAssignments UserRoleAssignment[] @relation("RevokedBy")
  sessions           Session[]
  auditLogs          AuditLog[]

  @@map("users")
}

enum RoleScope {
  PLATFORM
  TENANT
  COMPANY
}

model Role {
  id            String      @id @default(uuid(7)) @db.Uuid
  key           String      @unique @db.VarChar(64)
  name          String      @db.VarChar(120)
  description   String      @db.VarChar(500)
  allowedScopes RoleScope[] @map("allowed_scopes")
  participant   Boolean     @default(false)
  isSystem      Boolean     @default(true) @map("is_system")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique @db.VarChar(80)
  description String @db.VarChar(300)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Grants a role to a user at PLATFORM, TENANT or COMPANY scope.
/// Scope consistency and "one active assignment" are enforced by SQL constraints
/// in the migration (see docs/DATABASE.md).
model UserRoleAssignment {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  scope       RoleScope
  tenantId    String?   @map("tenant_id") @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid
  grantedById String?   @map("granted_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById String?   @map("revoked_by_id") @db.Uuid

  user      User     @relation("AssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  grantedBy User?    @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy User?    @relation("RevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([companyId])
  @@map("user_role_assignments")
}

/// Server-side session. Only a SHA-256 hash of the opaque cookie token is stored.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(400)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── Audit ─────────────────────────────────────────────────────────────

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

/// Append-only audit trail. UPDATE and DELETE are blocked by a database trigger.
model AuditLog {
  id          String       @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?      @map("actor_user_id") @db.Uuid
  /// Snapshot of the actor email at the time of the event.
  actorEmail  String?      @map("actor_email") @db.VarChar(254)
  action      String       @db.VarChar(80)
  outcome     AuditOutcome
  tenantId    String?      @map("tenant_id") @db.Uuid
  companyId   String?      @map("company_id") @db.Uuid
  targetType  String?      @map("target_type") @db.VarChar(60)
  targetId    String?      @map("target_id") @db.VarChar(64)
  ipAddress   String?      @map("ip_address") @db.VarChar(64)
  userAgent   String?      @map("user_agent") @db.VarChar(400)
  requestId   String?      @map("request_id") @db.VarChar(64)
  /// Structured details. Must never contain secrets, tokens, OTPs or ballot choices.
  metadata    Json         @default("{}")

  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([companyId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}
