// IRM Platform — PostgreSQL schema.
//
// Phase A (foundation) entities only. Later phases add shareholder, meeting,
// voting and communication models in additive migrations. The full target ERD
// is documented in docs/DATABASE.md.
//
// Conventions
// - UUID primary keys generated by the database.
// - snake_case table and column names via @@map / @map.
// - Every company-owned row carries tenant_id and company_id for isolation.
// - Timestamps are timestamptz.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ─── Platform & tenancy ────────────────────────────────────────────────

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// An organizational tenant: usually one corporate group.
model Tenant {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String       @db.VarChar(160)
  slug      String       @unique @db.VarChar(60)
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  companies   Company[]
  assignments UserRoleAssignment[]
  auditLogs   AuditLog[]

  @@map("tenants")
}

enum CompanyType {
  PUBLIC_LISTED
  PUBLIC_UNLISTED
  PRIVATE
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED
}

/// A legal entity that holds AGMs/EGMs. Belongs to exactly one tenant.
model Company {
  id                 String        @id @default(uuid(7)) @db.Uuid
  tenantId           String        @map("tenant_id") @db.Uuid
  legalName          String        @map("legal_name") @db.VarChar(200)
  shortName          String        @map("short_name") @db.VarChar(60)
  slug               String        @db.VarChar(60)
  companyType        CompanyType   @map("company_type")
  registrationNumber String?       @map("registration_number") @db.VarChar(60)
  tradingCode        String?       @map("trading_code") @db.VarChar(20)
  registeredAddress  String?       @map("registered_address") @db.VarChar(500)
  contactEmail       String?       @map("contact_email") @db.VarChar(254)
  timezone           String        @default("Asia/Dhaka") @db.VarChar(64)
  status             CompanyStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  assignments UserRoleAssignment[]
  auditLogs   AuditLog[]

  @@unique([tenantId, slug])
  /// Composite key target so child rows can enforce (tenant_id, company_id) consistency.
  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("companies")
}

// ─── Identity & access ─────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

/// A login identity. Users are global; what they can see is defined only by role assignments.
enum UserKind {
  /// Company and platform staff. Sign in with email, password and optional TOTP.
  STAFF
  /// Shareholders, corporate representatives and proxies. Sign in with a one-time code only.
  PARTICIPANT
}

model User {
  id                String     @id @default(uuid(7)) @db.Uuid
  kind              UserKind   @default(STAFF)
  /// Required for staff. Individual shareholders may have only a phone number.
  email             String?    @unique @db.VarChar(254)
  phone             String?    @db.VarChar(20)
  fullName          String     @map("full_name") @db.VarChar(160)
  /// argon2id hash. Null for participant identities that log in by OTP only.
  passwordHash      String?    @map("password_hash")
  status            UserStatus @default(ACTIVE)
  failedLoginCount  Int        @default(0) @map("failed_login_count")
  lockedUntil       DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt       DateTime?  @map("last_login_at") @db.Timestamptz(3)
  mfaEnabled        Boolean    @default(false) @map("mfa_enabled")
  /// AES-256-GCM encrypted TOTP secret (iv.tag.ciphertext, base64url). Never returned by the API.
  mfaSecretEnc      String?    @map("mfa_secret_enc")
  /// Last accepted TOTP time step, to block code replay.
  mfaLastStep       Int?       @map("mfa_last_step")
  /// SHA-256 hashes of unused recovery codes.
  mfaRecoveryHashes String[]   @default([]) @map("mfa_recovery_hashes")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  assignments        UserRoleAssignment[] @relation("AssignedUser")
  grantedAssignments UserRoleAssignment[] @relation("GrantedBy")
  revokedAssignments UserRoleAssignment[] @relation("RevokedBy")
  sessions           Session[]
  auditLogs          AuditLog[]
  participantLinks   ParticipantLink[]

  @@map("users")
}

enum RoleScope {
  PLATFORM
  TENANT
  COMPANY
}

model Role {
  id            String      @id @default(uuid(7)) @db.Uuid
  key           String      @unique @db.VarChar(64)
  name          String      @db.VarChar(120)
  description   String      @db.VarChar(500)
  allowedScopes RoleScope[] @map("allowed_scopes")
  participant   Boolean     @default(false)
  isSystem      Boolean     @default(true) @map("is_system")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String @id @default(uuid(7)) @db.Uuid
  key         String @unique @db.VarChar(80)
  description String @db.VarChar(300)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Grants a role to a user at PLATFORM, TENANT or COMPANY scope.
/// Scope consistency and "one active assignment" are enforced by SQL constraints
/// in the migration (see docs/DATABASE.md).
model UserRoleAssignment {
  id          String    @id @default(uuid(7)) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  scope       RoleScope
  tenantId    String?   @map("tenant_id") @db.Uuid
  companyId   String?   @map("company_id") @db.Uuid
  grantedById String?   @map("granted_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(3)
  revokedById String?   @map("revoked_by_id") @db.Uuid

  user      User     @relation("AssignedUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)
  grantedBy User?    @relation("GrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy User?    @relation("RevokedBy", fields: [revokedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
  @@index([companyId])
  @@map("user_role_assignments")
}

/// Server-side session. Only a SHA-256 hash of the opaque cookie token is stored.
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(400)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// ─── Audit ─────────────────────────────────────────────────────────────

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILURE
}

/// Append-only audit trail. UPDATE and DELETE are blocked by a database trigger.
model AuditLog {
  id          String       @id @default(uuid(7)) @db.Uuid
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)
  actorUserId String?      @map("actor_user_id") @db.Uuid
  /// Snapshot of the actor email at the time of the event.
  actorEmail  String?      @map("actor_email") @db.VarChar(254)
  action      String       @db.VarChar(80)
  outcome     AuditOutcome
  tenantId    String?      @map("tenant_id") @db.Uuid
  companyId   String?      @map("company_id") @db.Uuid
  targetType  String?      @map("target_type") @db.VarChar(60)
  targetId    String?      @map("target_id") @db.VarChar(64)
  ipAddress   String?      @map("ip_address") @db.VarChar(64)
  userAgent   String?      @map("user_agent") @db.VarChar(400)
  requestId   String?      @map("request_id") @db.VarChar(64)
  /// Structured details. Must never contain secrets, tokens, OTPs or ballot choices.
  metadata    Json         @default("{}")

  actor   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  tenant  Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([companyId, occurredAt(sort: Desc)])
  @@index([actorUserId, occurredAt(sort: Desc)])
  @@index([action])
  @@map("audit_logs")
}

// ═══ Phase B: shareholder system ═══════════════════════════════════════
// Every table below carries tenant_id and company_id, has a composite FK to
// companies(id, tenant_id), and is protected by PostgreSQL row-level security
// (see the phase_b migration and docs/DATABASE.md).

model ShareClass {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  code          String   @db.VarChar(12)
  name          String   @db.VarChar(80)
  votesPerShare Int      @default(1) @map("votes_per_share")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  holdings Shareholding[]

  @@unique([companyId, code])
  @@map("share_classes")
}

enum HolderType {
  INDIVIDUAL
  CORPORATE
}

enum ShareholderStatus {
  ACTIVE
  INACTIVE
}

model Shareholder {
  id        String            @id @default(uuid(7)) @db.Uuid
  tenantId  String            @map("tenant_id") @db.Uuid
  companyId String            @map("company_id") @db.Uuid
  type      HolderType
  name      String            @db.VarChar(200)
  nameBn    String?           @map("name_bn") @db.VarChar(200)
  status    ShareholderStatus @default(ACTIVE)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  identities       ShareholderIdentity[]
  contacts         ShareholderContact[]
  corporateReps    CorporateRepresentative[]
  proxiesGranted   ProxyAuthorization[]
  participantLinks ParticipantLink[]

  @@index([companyId, name])
  @@map("shareholders")
}

enum IdentityKind {
  BO
  FOLIO
}

/// A BO account or folio. One shareholder may hold several, which is common for corporate holders.
model ShareholderIdentity {
  id            String       @id @default(uuid(7)) @db.Uuid
  tenantId      String       @map("tenant_id") @db.Uuid
  companyId     String       @map("company_id") @db.Uuid
  shareholderId String       @map("shareholder_id") @db.Uuid
  kind          IdentityKind
  value         String       @db.VarChar(20)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  shareholder Shareholder    @relation(fields: [shareholderId], references: [id], onDelete: Restrict)
  holdings    Shareholding[]

  @@unique([companyId, kind, value])
  @@index([shareholderId])
  @@map("shareholder_identities")
}

enum ContactKind {
  PHONE
  EMAIL
}

enum ContactSource {
  REGISTER
  MANUAL
}

/// Contacts used for one-time sign-in codes. Register contacts are the official record.
model ShareholderContact {
  id            String        @id @default(uuid(7)) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  companyId     String        @map("company_id") @db.Uuid
  shareholderId String        @map("shareholder_id") @db.Uuid
  kind          ContactKind
  value         String        @db.VarChar(254)
  source        ContactSource
  verifiedAt    DateTime?     @map("verified_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  retiredAt     DateTime?     @map("retired_at") @db.Timestamptz(3)

  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Restrict)

  @@index([shareholderId])
  @@map("shareholder_contacts")
}

/// Versioned holding. A change closes the current row (valid_to) and opens a new one.
model Shareholding {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  companyId    String    @map("company_id") @db.Uuid
  identityId   String    @map("identity_id") @db.Uuid
  shareClassId String    @map("share_class_id") @db.Uuid
  quantity     BigInt
  asOfDate     DateTime  @map("as_of_date") @db.Date
  validFrom    DateTime  @default(now()) @map("valid_from") @db.Timestamptz(3)
  validTo      DateTime? @map("valid_to") @db.Timestamptz(3)
  importId     String?   @map("import_id") @db.Uuid

  identity   ShareholderIdentity @relation(fields: [identityId], references: [id], onDelete: Restrict)
  shareClass ShareClass          @relation(fields: [shareClassId], references: [id], onDelete: Restrict)
  import     RegisterImport?     @relation(fields: [importId], references: [id], onDelete: Restrict)

  @@index([companyId, validTo])
  @@index([identityId])
  @@map("shareholdings")
}

enum ImportStatus {
  UPLOADED
  VALIDATED
  COMMITTED
  CANCELLED
  FAILED
}

enum ImportMode {
  FULL
  DELTA
}

model RegisterImport {
  id             String       @id @default(uuid(7)) @db.Uuid
  tenantId       String       @map("tenant_id") @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  fileId         String       @map("file_id") @db.Uuid
  status         ImportStatus @default(UPLOADED)
  mode           ImportMode?
  asOfDate       DateTime?    @map("as_of_date") @db.Date
  headers        String[]
  mapping        Json?
  totalRows      Int          @default(0) @map("total_rows")
  validRows      Int          @default(0) @map("valid_rows")
  errorRows      Int          @default(0) @map("error_rows")
  /// Counts by action after validation: new, changed, unchanged, closed.
  summary        Json?
  createdById    String       @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  validatedAt    DateTime?    @map("validated_at") @db.Timestamptz(3)
  committedById  String?      @map("committed_by_id") @db.Uuid
  committedAt    DateTime?    @map("committed_at") @db.Timestamptz(3)
  failureMessage String?      @map("failure_message") @db.VarChar(500)

  file     StoredFile          @relation(fields: [fileId], references: [id], onDelete: Restrict)
  rows     RegisterImportRow[]
  holdings Shareholding[]

  @@index([companyId, createdAt(sort: Desc)])
  @@map("register_imports")
}

enum ImportRowStatus {
  VALID
  ERROR
}

enum ImportRowAction {
  NEW
  CHANGED
  UNCHANGED
  CLOSED
  NONE
}

model RegisterImportRow {
  id         String          @id @default(uuid(7)) @db.Uuid
  tenantId   String          @map("tenant_id") @db.Uuid
  companyId  String          @map("company_id") @db.Uuid
  importId   String          @map("import_id") @db.Uuid
  rowNumber  Int             @map("row_number")
  raw        Json
  normalized Json?
  status     ImportRowStatus
  action     ImportRowAction @default(NONE)
  errors     String[]        @default([])

  import RegisterImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, status])
  @@map("register_import_rows")
}

enum FileKind {
  REGISTER_IMPORT
  AUTHORIZATION_DOCUMENT
  MEETING_DOCUMENT
}

/// Metadata for a privately stored file. Content lives in the storage driver under storage_key.
model StoredFile {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  kind         FileKind
  storageKey   String   @unique @map("storage_key") @db.VarChar(200)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    Int      @map("size_bytes")
  sha256       String   @db.VarChar(64)
  uploadedById String   @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  imports          RegisterImport[]
  corporateReps    CorporateRepresentative[]
  proxies          ProxyAuthorization[]
  meetingDocuments MeetingDocument[]

  @@map("stored_files")
}

enum AuthorizationStatus {
  PENDING
  APPROVED
  REJECTED
  REVOKED
}

model CorporateRepresentative {
  id            String              @id @default(uuid(7)) @db.Uuid
  tenantId      String              @map("tenant_id") @db.Uuid
  companyId     String              @map("company_id") @db.Uuid
  shareholderId String              @map("shareholder_id") @db.Uuid
  fullName      String              @map("full_name") @db.VarChar(160)
  designation   String?             @db.VarChar(120)
  email         String              @db.VarChar(254)
  phone         String?             @db.VarChar(20)
  /// BO/folio identities this representative may act for.
  identityIds   String[]            @map("identity_ids") @db.Uuid
  validFrom     DateTime            @map("valid_from") @db.Date
  validUntil    DateTime            @map("valid_until") @db.Date
  status        AuthorizationStatus @default(PENDING)
  documentId    String?             @map("document_id") @db.Uuid
  createdById   String              @map("created_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedById   String?             @map("decided_by_id") @db.Uuid
  decidedAt     DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionNote  String?             @map("decision_note") @db.VarChar(500)

  shareholder Shareholder @relation(fields: [shareholderId], references: [id], onDelete: Restrict)
  document    StoredFile? @relation(fields: [documentId], references: [id], onDelete: Restrict)

  @@index([companyId, email])
  @@map("corporate_representatives")
}

enum ProxyScope {
  ATTEND
  ATTEND_AND_VOTE
}

model ProxyAuthorization {
  id                   String              @id @default(uuid(7)) @db.Uuid
  tenantId             String              @map("tenant_id") @db.Uuid
  companyId            String              @map("company_id") @db.Uuid
  grantorShareholderId String              @map("grantor_shareholder_id") @db.Uuid
  fullName             String              @map("full_name") @db.VarChar(160)
  email                String              @db.VarChar(254)
  phone                String?             @db.VarChar(20)
  scope                ProxyScope
  /// Required for new proxies since Phase C. Older proxies keep only meeting_reference.
  meetingId            String?             @map("meeting_id") @db.Uuid
  /// Display name of the meeting, copied from the meeting at creation.
  meetingReference     String              @map("meeting_reference") @db.VarChar(160)
  validFrom            DateTime            @map("valid_from") @db.Date
  validUntil           DateTime            @map("valid_until") @db.Date
  status               AuthorizationStatus @default(PENDING)
  documentId           String?             @map("document_id") @db.Uuid
  createdById          String              @map("created_by_id") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  decidedById          String?             @map("decided_by_id") @db.Uuid
  decidedAt            DateTime?           @map("decided_at") @db.Timestamptz(3)
  decisionNote         String?             @map("decision_note") @db.VarChar(500)

  grantor  Shareholder @relation(fields: [grantorShareholderId], references: [id], onDelete: Restrict)
  document StoredFile? @relation(fields: [documentId], references: [id], onDelete: Restrict)
  meeting  Meeting?    @relation(fields: [meetingId], references: [id], onDelete: Restrict)

  @@index([companyId, email])
  @@index([meetingId])
  @@map("proxy_authorizations")
}

enum ParticipantKind {
  SHAREHOLDER
  CORPORATE_REPRESENTATIVE
  PROXY_REPRESENTATIVE
}

/// Links a participant login to what it represents inside one company.
model ParticipantLink {
  id             String          @id @default(uuid(7)) @db.Uuid
  tenantId       String          @map("tenant_id") @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  userId         String          @map("user_id") @db.Uuid
  kind           ParticipantKind
  shareholderId  String?         @map("shareholder_id") @db.Uuid
  corporateRepId String?         @map("corporate_rep_id") @db.Uuid
  proxyId        String?         @map("proxy_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  shareholder Shareholder? @relation(fields: [shareholderId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([companyId])
  @@map("participant_links")
}

// ─── One-time codes and development outbox ────────────────────────────

enum OtpPurpose {
  PARTICIPANT_LOGIN
  MFA_LOGIN
}

/// A pending one-time code or MFA step. Only hashes are stored.
model OtpChallenge {
  id         String     @id @default(uuid(7)) @db.Uuid
  purpose    OtpPurpose
  /// SHA-256 of the 6-digit code (participant) or of the MFA step token.
  secretHash String     @map("secret_hash") @db.VarChar(64)
  /// Who is signing in. Never contains the code.
  subject    Json
  userId     String?    @map("user_id") @db.Uuid
  attempts   Int        @default(0)
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz(3)
  ipAddress  String?    @map("ip_address") @db.VarChar(64)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("otp_challenges")
}

/// DEVELOPMENT ONLY. Messages that would go out by SMS or email when no provider is configured.
/// The API refuses to write here when NODE_ENV=production.
model DevOutboxMessage {
  id        String      @id @default(uuid(7)) @db.Uuid
  channel   ContactKind
  recipient String      @db.VarChar(254)
  subject   String      @db.VarChar(200)
  body      String      @db.VarChar(2000)
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@map("dev_outbox_messages")
}

// ═══ Phase C: meeting management ═══════════════════════════════════════
// Company-owned tables carry tenant_id and company_id, a composite FK to
// companies(id, tenant_id), and an RLS policy (see the phase_c migration).

enum MeetingType {
  AGM
  EGM
}

enum MeetingMode {
  VIRTUAL
  HYBRID
}

enum MeetingState {
  DRAFT
  SCHEDULED
  REGISTRATION_OPEN
  LIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

model Meeting {
  id              String       @id @default(uuid(7)) @db.Uuid
  tenantId        String       @map("tenant_id") @db.Uuid
  companyId       String       @map("company_id") @db.Uuid
  type            MeetingType
  title           String       @db.VarChar(200)
  description     String?      @db.VarChar(2000)
  noticeText      String?      @map("notice_text")
  mode            MeetingMode  @default(VIRTUAL)
  venue           String?      @db.VarChar(300)
  scheduledStart  DateTime     @map("scheduled_start") @db.Timestamptz(3)
  timezone        String       @default("Asia/Dhaka") @db.VarChar(64)
  recordDate      DateTime     @map("record_date") @db.Date
  state           MeetingState @default(DRAFT)
  /// Optimistic concurrency counter, incremented on every change.
  version         Int          @default(1)
  /// Validated against meetingRulesSchema in @irm/shared. Locked once the meeting goes live.
  rules           Json
  publishedAt     DateTime?    @map("published_at") @db.Timestamptz(3)
  snapshotTakenAt DateTime?    @map("snapshot_taken_at") @db.Timestamptz(3)
  startedAt       DateTime?    @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime?    @map("ended_at") @db.Timestamptz(3)
  createdById     String       @map("created_by_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  transitions  MeetingStateTransition[]
  agendaItems  AgendaItem[]
  documents    MeetingDocument[]
  staff        MeetingStaff[]
  participants MeetingParticipant[]
  snapshots    ShareholdingSnapshot[]
  entitlements VotingEntitlement[]
  proxies      ProxyAuthorization[]

  @@index([companyId, scheduledStart])
  @@map("meetings")
}

/// Append-only history of state changes.
model MeetingStateTransition {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  meetingId   String        @map("meeting_id") @db.Uuid
  fromState   MeetingState? @map("from_state")
  toState     MeetingState  @map("to_state")
  actorUserId String?       @map("actor_user_id") @db.Uuid
  reason      String?       @db.VarChar(500)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)

  @@index([meetingId, createdAt])
  @@map("meeting_state_transitions")
}

model AgendaItem {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  meetingId   String   @map("meeting_id") @db.Uuid
  number      String   @db.VarChar(10)
  title       String   @db.VarChar(300)
  description String?  @db.VarChar(5000)
  position    Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  meeting    Meeting           @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  resolution Resolution?
  documents  MeetingDocument[]

  @@unique([meetingId, number])
  @@index([meetingId, position])
  @@map("agenda_items")
}

enum ResolutionKind {
  ORDINARY
  SPECIAL
}

model Resolution {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @map("tenant_id") @db.Uuid
  companyId         String         @map("company_id") @db.Uuid
  agendaItemId      String         @unique @map("agenda_item_id") @db.Uuid
  kind              ResolutionKind
  text              String
  requiresProposal  Boolean        @default(true) @map("requires_proposal")
  requiresSeconding Boolean        @default(true) @map("requires_seconding")

  agendaItem AgendaItem @relation(fields: [agendaItemId], references: [id], onDelete: Cascade)

  @@map("resolutions")
}

enum MeetingDocumentKind {
  NOTICE
  ANNUAL_REPORT
  FINANCIAL_STATEMENTS
  PROXY_FORM
  PRESENTATION
  OTHER
}

model MeetingDocument {
  id           String              @id @default(uuid(7)) @db.Uuid
  tenantId     String              @map("tenant_id") @db.Uuid
  companyId    String              @map("company_id") @db.Uuid
  meetingId    String              @map("meeting_id") @db.Uuid
  agendaItemId String?             @map("agenda_item_id") @db.Uuid
  kind         MeetingDocumentKind
  title        String              @db.VarChar(200)
  fileId       String              @map("file_id") @db.Uuid
  /// Visible to participants once the meeting is published.
  published    Boolean             @default(false)
  uploadedById String              @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  removedAt    DateTime?           @map("removed_at") @db.Timestamptz(3)

  meeting    Meeting     @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  agendaItem AgendaItem? @relation(fields: [agendaItemId], references: [id], onDelete: SetNull)
  file       StoredFile  @relation(fields: [fileId], references: [id], onDelete: Restrict)

  @@index([meetingId])
  @@map("meeting_documents")
}

enum MeetingStaffRole {
  BOARD_MEMBER
  MODERATOR
}

model MeetingStaff {
  id        String           @id @default(uuid(7)) @db.Uuid
  tenantId  String           @map("tenant_id") @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  meetingId String           @map("meeting_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      MeetingStaffRole
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)

  @@unique([meetingId, userId, role])
  @@map("meeting_staff")
}

/// Holdings frozen at the record date when registration opens. Immutable.
model ShareholdingSnapshot {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  meetingId     String   @map("meeting_id") @db.Uuid
  shareholderId String   @map("shareholder_id") @db.Uuid
  identityId    String   @map("identity_id") @db.Uuid
  shareClassId  String   @map("share_class_id") @db.Uuid
  holdingId     String   @map("holding_id") @db.Uuid
  quantity      BigInt
  votesPerShare Int      @map("votes_per_share")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  meeting     Meeting            @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  entitlement VotingEntitlement?

  @@unique([meetingId, identityId, shareClassId])
  @@index([meetingId, shareholderId])
  @@map("shareholding_snapshots")
}

/// One voting entitlement per snapshot row with votes. Used by the voting engine (Phase E). Immutable.
model VotingEntitlement {
  id            String   @id @default(uuid(7)) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  companyId     String   @map("company_id") @db.Uuid
  meetingId     String   @map("meeting_id") @db.Uuid
  snapshotId    String   @unique @map("snapshot_id") @db.Uuid
  shareholderId String   @map("shareholder_id") @db.Uuid
  identityId    String   @map("identity_id") @db.Uuid
  weight        BigInt
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  meeting  Meeting              @relation(fields: [meetingId], references: [id], onDelete: Restrict)
  snapshot ShareholdingSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)

  @@index([meetingId, shareholderId])
  @@map("voting_entitlements")
}

enum MeetingParticipantStatus {
  REGISTERED
  CANCELLED
}

/// A registration to attend a meeting, in one capacity, for one shareholder.
model MeetingParticipant {
  id             String                   @id @default(uuid(7)) @db.Uuid
  tenantId       String                   @map("tenant_id") @db.Uuid
  companyId      String                   @map("company_id") @db.Uuid
  meetingId      String                   @map("meeting_id") @db.Uuid
  userId         String                   @map("user_id") @db.Uuid
  kind           ParticipantKind
  shareholderId  String                   @map("shareholder_id") @db.Uuid
  corporateRepId String?                  @map("corporate_rep_id") @db.Uuid
  proxyId        String?                  @map("proxy_id") @db.Uuid
  /// Entitlements this registration covers.
  entitlementIds String[]                 @map("entitlement_ids") @db.Uuid
  status         MeetingParticipantStatus @default(REGISTERED)
  registeredAt   DateTime                 @default(now()) @map("registered_at") @db.Timestamptz(3)

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Restrict)

  @@unique([meetingId, userId, kind, shareholderId])
  @@index([meetingId, status])
  @@map("meeting_participants")
}
